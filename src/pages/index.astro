---
import Canvas from '../components/canvas.tsx';
import '../styles/index.css';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<section class="hero doodle">
			<Canvas className="doodle-canvas" client:load/>

			<div class="hero-content bottom center">
				<p>
					Want to see more? Scroll down!
					<br>
					↓
				</p>
			</div>
		</section>

		<section class="hero">
			<div class="hero-content left middle align-left">
				<span>
					<h1>Sam Rhys Kynaston</h1>
					<p>Full Stack Developer, Software Engineer with experience in <b>Luau</b>, <b>C#</b>, <b>Java</b>, <b>Typescript</b> and <b>Python</b>.</p>
					<div class="flex-row">
						<a href="">Github</a>
						<a href="">LinkedIn</a>
						<a href="">Email</a>
					</div>
				</span>
				<img src="/ProfileIcon.jpg" class="icon"/>
			</div>
		</section>
	</body>
</html>
